        <!-- Page Content  -->
        <div id="content">
            <div class="my-custom" class="col s12">
                <div class="navbar navbar-inverse navbar-static-top" >
                    <div class="container">
                        <a href="/admin/panel" class="navbar-brand">Admin Dashboard</a>
                        <a href="#">Logout</a>
                    </div>
                </div>
                
                <%= typeof msg != 'undefined' ? msg : '' %>
                <div class="row" style="margin-left: 30px;">
                    <form action="http://localhost:8000/admin/panel/menu/add" method="post" class="col s12" style="margin-top: 20px;">
                        <input type="hidden" name="menu_id" value="">
                    
                        <div class="form-group row">
                            <label for="menu_name" class="col-2 col-form-label">Menu_Name</label>
                            <div class="col-10">
                                <input style="margin-top: 0px;" type="text" name="menu_name" value="<%= validatedData.menu_name %>" class="form-control" style="margin-left: -100px;">
                                <% if(errors.menu_name) { %>
                                    <div class="container" style="margin-left: -115px; margin-top: 10px;">
                                        <div class="alert alert-danger">
                                            <%= errors.menu_name.msg %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="menu_service_time" class="col-2 col-form-label">Service_Time</label>
                            <div class="col-10">
                                <input style="margin-top: 0px;" type="number" name="menu_service_time" value="<%= validatedData.menu_service_time %>" class="form-control"style="margin-left: -100px;">
                                <% if(errors.menu_service_time) { %>
                                    <div class="container" style="margin-left: -115px; margin-top: 10px;">
                                        <div class="alert alert-danger">
                                            <%= errors.menu_service_time.msg %>
                                        </div>
                                    </div>
                                <% } %>            
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="menu_price_regular" class="col-2 col-form-label">Price_Regular</label>
                            <div class="col-10">
                                <input style="margin-top: 0px; margin-left: 5px;" type="number" name="menu_price_regular" value="<%= validatedData.menu_price_regular %>" class="form-control"style="margin-left: -100px;">
                                <% if(errors.menu_price_regular) { %>
                                    <div class="container" style="margin-left: -115px; margin-top: 10px;">
                                        <div class="alert alert-danger">
                                            <%= errors.menu_price_regular.msg %>
                                        </div>
                                    </div>
                                <% } %>            
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="menu_price_large" class="col-2 col-form-label">Price_Large</label>
                            <div class="col-10">
                                <input style="margin-top: 0px;" type="number" name="menu_price_large" value="<%= validatedData.menu_price_large %>" class="form-control"style="margin-left: -100px;">
                                <% if(errors.menu_price_large) { %>
                                    <div class="container" style="margin-left: -115px; margin-top: 10px;">
                                        <div class="alert alert-danger">
                                            <%= errors.menu_price_large.msg %>
                                        </div>
                                    </div>
                                <% } %>            
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="menu_price_xlarge" class="col-2 col-form-label">Price_Extra_Large</label>
                            <div class="col-10">
                                <input style="margin-top: 0px; margin-left: 35px;" type="number" name="menu_price_xlarge" value="<%= validatedData.menu_price_xlarge %>" class="form-control"style="margin-left: -100px;">
                                <% if(errors.menu_price_xlarge) { %>
                                    <div class="container" style="margin-left: -115px; margin-top: 10px;">
                                        <div class="alert alert-danger">
                                            <%= errors.menu_price_xlarge.msg %>
                                        </div>
                                    </div>
                                <% } %>            
                            </div>
                        </div>
  
                        <div class="form-group row">
                            <label for="" class="col-2 col-form-label" style="color:#ffffff">Submit</label>
                            <div class="col-10">
                                <input type="submit" name="submit" value="Save event" class="btn btn-primary btn-lg"style="margin-left: -100px;">
                            </div>
                        </div>
                    </form>


                </div>
                

        </div>
        


    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/main.js"></script>
