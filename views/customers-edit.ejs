        <!-- Page Content  -->
        <div id="content">
            <div class="my-custom" class="col s12">
                <div class="navbar navbar-inverse navbar-static-top" >
                    <div class="container">
                        <a href="/admin/panel" class="navbar-brand">Admin Dashboard</a>
                        <a href="#">Logout</a>
                    </div>
                </div>
                
                <div class="row" style="margin-left: 30px;">
                    <form action="http://localhost:8000/admin/panel/customers/edit/<%= item[0].user_id %>" method="post" class="col s12" style="margin-top: 20px;">
                        <input type="hidden" name="user_id" value="<%= item[0].user_id %>">
                    
                        <div class="form-group row">
                            <label for="user_first_name" class="col-2 col-form-label">First_Name</label>
                            <div class="col-10" style="margin-top: 40px;">
                                <input type="text" name="user_first_name" value="<%= item[0].user_first_name %>" class="form-control" style="margin-left: -100px;">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="user_last_name" class="col-2 col-form-label">Last_Name</label>
                            <div class="col-10" style="margin-top: 40px;">
                                <input type="text" name="user_last_name" value="<%= item[0].user_last_name %>" class="form-control"style="margin-left: -100px;">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="user_address" class="col-2 col-form-label">Address</label>
                            <div class="col-10" style="margin-top: 40px;">
                                <input type="text" name="user_address" value="<%= item[0].user_address %>" class="form-control"style="margin-left: -100px;">
                            </div>
                        </div>                      
                        <div class="form-group row">
                            <label for="user_phone_no" class="col-2 col-form-label">Phone_Number</label>
                            <div class="col-10" style="margin-top: 40px;">
                                <input type="text" name="user_phone_no" value="<%= item[0].user_phone_no %>" class="form-control"style="margin-left: -100px;">
                            </div>
                        </div>                        
                        <div class="form-group row">
                            <label for="user_password" class="col-2 col-form-label">Password</label>
                            <div class="col-10"style="margin-top: 40px;">
                                <input type="password" name="user_password" value="<%= item[0].user_password %>" class="form-control"style="margin-left: -100px;">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="submit" class="col-2 col-form-label" style="color:#ffffff">Submit</label>
                            <div class="col-10">
                                <input type="submit" name="submit" value="Save event" class="btn btn-primary btn-lg"style="margin-left: -100px;">
                            </div>
                        </div>
                    </form>
                </div>
                

        </div>
        


    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>