          <!-- Page Content  -->
          <div id="content">
              <div class="my-custom" class="col s12">
                  <div class="navbar navbar-inverse navbar-static-top" >
                      <div class="container">
                          <a href="/admin/panel" class="navbar-brand">Admin Dashboard</a>
                          <a href="#">Logout</a>
                      </div>
                  </div>
                  <div class="container">
                      <h1>Manage customers</h1>
                  </div>
                  <div id="my-custom">
                      <% if (items.length > 0) { %>
                          <table class="table">
                              <thread>
                                  <tr>
                                      <th style="width:1%; text-align:center">ID</th>
                                      <th style="width:49%;">Menu Name</th>
                                      <th style="width:20%;">Service Time</th>
                                      <th style="width:20%; text-align: center;">Edit</th>
                                      <th style="width:20%; text-align: center;">Delete</th>
                                  </tr>
                              </thread>
                              <tbody>
                                  <% items.forEach(function(item, index){ %>
                                      <% if (index < 0) { %>
                                          <% index=index+1 %>
                                      <% } %>
                                      <tr>
                                          <td style="width:1%; text-align: center"><%= index + 1 %></td>
                                          <td style="width:49%;"><%= item.menu_name %></td>
                                          <td style="width:49%;"><%= item.menu_service_time %></td>
                                          <td solspane="2" style="width:20%; text-align: center;">
                                              <a href="/admin/panel/customers/edit/<%= item.user_id %>" class="btn btn-success">Edit</a>
                                          </td>
                                          <td solspane="2" style="width:20%; text-align: center;">
                                              <a href="/admin/panel/menu/delete/<%= item.menu_id %>" class="btn btn-danger">Delete</a>
                                          </td>
                                      </tr>
                                  <% }); %>
                              </tbody>
                          </table>
                      <% }else{ %>
                          <p> <strong>There are no records available</strong> </p>
                      <% } %>
