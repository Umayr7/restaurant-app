<%- include('partials/header'); %>

<header>
    <div class="container">
        <a class="logo" href="/"><img src="/images/logo-white.png" alt="Logo"></a>
            
        <a class="menu-nav-icon" data-menu="#main-menu" href="#"><i class="ion-navicon"></i></a>
        

            <ul class="main-menu font-mountainsre" id="main-menu">
                    
                <div class="right-area">
                        <a class="plr-20 color-white btn-fill-primary" href="/checkout">  <i class="fa fa-shopping-cart" style="font-size:24px;color:white;margin-top: 10px;margin-left: 0px;"></i></a>
                </div><!-- right-area -->
                <li><a href="/">HOME</a></li>
                <li><a href="/about">ABOUT US</a></li>
                <li><a href="/contact">CONTACT</a></li>  
                <% if(user_obj.f_name) { %>
                        <li> <a> <%= user_obj.f_name %> </a> </li>
                        <li><a href="/logout">LOGOUT</a></li>
                <% } else { %>
                        <li><a href="/register">SIGNUP</a></li>
                        <li><a href="/login">LOGIN</a></li>
                <% } %>
            </ul>
        
        <div class="clearfix"></div>
    </div><!-- container -->
</header>


<section class="bg-1 h-900x main-slider pos-relative">
    <div class="triangle-up pos-bottom"></div>
    <div class="container h-100">
            <div class="dplay-tbl">
                    <div class="dplay-tbl-cell center-text color-white">
                        <%- messages('message', locals) %>
                            <h5><b>BEST IN TOWN</b></h5>
                            <h1 class="mt-30 mb-15">Pizza & Pasta</h1>
                            <!-- <h5><a href="#" class="btn-primaryc plr-25"><b>SEE TODAYS MENU</b></a></h5> -->
                    </div><!-- dplay-tbl-cell -->
            </div><!-- dplay-tbl -->
    </div><!-- container -->
</section>

<section class="story-area bg-seller color-white pos-relative">
    <div class="pos-bottom triangle-up"></div>
    <div class="pos-top triangle-bottom"></div>
    <div class="container">
            <div class="heading">
                    <img class="heading-img" src="images/heading_logo.png" alt="">
                    <h2>Best Sellers</h2>
            </div>

         <div class="row">

                <% items.forEach(function(item, index){ %>
                        <% if (index < 0) { %>
                            <% index=index+1 %>
                        <% } %>

                        <div class="col-lg-3 col-md-4  col-sm-6 ">
                                <div class="center-text mb-30">
                                        <div class="ïmg-200x mlr-auto pos-relative"><img src="<%= item.menu_image %>" alt=""></div>
                                        <h5 class="mt-20"><%= item.menu_name %></h5>
                                        <h4 class="mt-5"><b>Rs. <%= item.menu_price_regular %>/-</b></h4>
                                        <h6 class="mt-20"><a href="/menu-detail/<%= item.menu_id %>" class="btn-brdr-primary plr-25"><b>Order Now</b></a></h6>
                                </div><!--text-center-->
                        </div><!-- col-md-3 -->
                    <% }); %>
        </div><!-- row -->
    </div><!-- container -->
</section>

<section>
        <div class="container">
                <div class="heading">
                        <img class="heading-img" src="images/heading_logo.png" alt="">
                        <h2>Our Menu</h2>
                </div>

                <div class="row">
                        <div class="col-sm-12">
                                <ul class="selecton brdr-b-primary mb-70">
                                        <li><a href="#" class="active" data-select="all"><b>All</b></a></li>
                                        <li><a href="#" data-select="pizza"><b>Specials</b></a></li>
                                </ul>
                        </div><!--col-sm-12-->
                </div><!--row-->

                <div class="row">
                        
                        </div><!-- food-menu -->

                        <% items.forEach(function(item, index){ %>
                                <% if (index < 0) { %>
                                    <% index=index+1 %>
                                <% } %>
                                <div class="col-md-6 food-menu all">
                                        <div class="sided-90x mb-30 ">
                                                <div class="s-left"><img class="br-3" src="<%= item.menu_image %>" alt=""></div><!--s-left-->
                                                <div class="s-right">
                                                        <h5 class="mb-10"><b>
                                                              <a href="/menu-detail/<%= item.menu_id %>"><%= item.menu_name %></a>
                                                        </b><b class="color-primary float-right">Rs. <%= item.menu_price_regular %>/-</b></h5>
                                                </div><!--s-right-->
                                        </div><!-- sided-90x -->
                                </div><!-- food-menu -->
                            <% }); %>
                        
                        <% for(var i=0 ; i < items.length ; i++) { %>
                                <% if (i%2 == 0) { %>
                                        
                                <% } else { %>
                                        <div class="col-md-6 food-menu pizza">
                                                <div class="sided-90x mb-30 ">
                                                        <div class="s-left"><img class="br-3" src="<%= items[i].menu_image %>" alt=""></div><!--s-left-->
                                                        <div class="s-right">
                                                                <h5 class="mb-10"><b>
                                                                        <a href="/menu-detail/<%= items[i].menu_id %>"><%= items[i].menu_name %></a>
                                                                  </b><b class="color-primary float-right">Rs. <%= items[i].menu_price_regular %>/-</b></h5>
                                                                </div><!--s-right-->
                                                </div><!-- sided-90x -->
                                        </div><!-- food-menu -->
                                <% } %>
                        <% } %>

                            
                        
                        </div><!-- food-menu -->                  
                        

                </div><!-- row -->
        
        </div><!-- container -->
</section>


<%- include('partials/footer'); %>
