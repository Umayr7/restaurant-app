  <body>
	<header>
		<div class="container">
			<a class="logo" href="/"><img src="/images/logo-white.png" alt="Logo"></a>
				
			<a class="menu-nav-icon" data-menu="#main-menu" href="#"><i class="ion-navicon"></i></a>
			
	
				<ul class="main-menu font-mountainsre" id="main-menu">
						
					<div class="right-area">
							<a class="plr-20 color-white btn-fill-primary" href="/checkout">  <i class="fa fa-shopping-cart" style="font-size:24px;color:white;margin-top: 10px;margin-left: 0px;"></i></a>
					</div><!-- right-area -->
					<li><a href="/">HOME</a></li>
					<li><a href="/about">ABOUT US</a></li>
					<li><a href="/contact">CONTACT</a></li>  
					<% if(user_obj.f_name) { %>
							<li> <a> <%= user_obj.f_name %> </a> </li>
							<li><a href="/logout">LOGOUT</a></li>
					<% } else { %>
							<li><a href="/register">SIGNUP</a></li>
							<li><a href="/login">LOGIN</a></li>
					<% } %>
				</ul>
			
			<div class="clearfix"></div>
		</div><!-- container -->
	</header>
	
	

	<div class="container" style="margin-top: 150px;">
		<%- messages('message', locals) %>
		<div class="card">
			<div class="container-fliud">
				<div class="wrapper row">
					<div class="preview col-md-6">
						<div class="preview-pic tab-content">
						  <!-- <div class="tab-pane active" id="pic-1"><img src="<%= item[0].menu_image %>" /></div> -->
						  <div class="ïmg-200x mlr-auto pos-relative"><img src="/<%= item[0].menu_image %>" alt=""></div>
						</div>
					</div>
					<div class="details col-md-6">
						<h3 class="product-title"><%= item[0].menu_name %></h3>
						<div class="rating">
							<div class="stars">
								<span class="fa fa-star checked"></span>
								<span class="fa fa-star checked"></span>
								<span class="fa fa-star checked"></span>
								<span class="fa fa-star"></span>
								<span class="fa fa-star"></span>
							</div>
							<span class="review-no">41 reviews</span>
						</div>
						<p class="product-description">Suspendisse quos? Tempus cras iure temporibus? Eu laudantium cubilia sem sem! Repudiandae et! Massa senectus enim minim sociosqu delectus posuere.</p>
						<form method="POST" action="http://localhost:8000/menu-detail/<%= item[0].menu_id %>">
							<h4> <label class="price" for="price1"> 
								<input type="checkbox" id="price1" name="menu_price_regular" value="regular">
								REGULAR PIZZA: <span> Rs. <%= item[0].menu_price_regular %>/- </span> 
							</label><br> </h4>						
							<h4> <label class="price" for="price2"> 
								<input type="checkbox" id="price2" name="menu_price_large" value="large">
								LARGE PIZZA: <span> Rs. <%= item[0].menu_price_large %>/- </span> 
							</label><br> </h4>						
							<h4> <label class="price" for="price3"> 
								<input type="checkbox" id="price3" name="menu_price_xlarge" value="xlarge">
								EXTRA LARGE PIZZA: <span> Rs. <%= item[0].menu_price_xlarge %>/- </span> 
							</label><br> </h4>
							<div class="action">
                                <!-- <input type="submit" name="submit" value="submit" class="btn btn-primary btn-lg"style="margin-left: -100px;" onclick="location.href='/menu-detail/<%= item[0].menu_id %>';" /> -->
								<!-- <a href="/menu-detail/<%= item[0].menu_id %>"> <button class="add-to-cart btn btn-default" type="submit">submit</button> </a> -->
								<!-- <a href="/cart/<%= item[0].menu_id %>"> <button class="add-to-cart btn btn-default" type="button">add to cart</button> </a> -->
								<!-- <input type="submit" name="Checkout" value="Checkout" class="add-to-cart btn btn-default" onclick="location.href='/checkout-bypass/<%= item[0].menu_id %>';" /> -->
								<!-- <a href="/checkout-request/<%= item[0].menu_id %>"> <button class="add-to-cart btn btn-default" type="button">Checkout</button> </a> -->
                                <!-- <input type="submit" name="Add to Cart" value="Add to Cart" class="add-to-cart btn btn-default" onclick="location.href='/cart/<%= item[0].menu_id %>';" /> -->
								
								
								<input type="submit" name="Cart" value="Add To Cart" class="add-to-cart btn btn-default" onclick="location.href='/menu-detail/<%= item[0].menu_id %>';" />
								<input type="submit" name="Checkout" value="Checkout" class="add-to-cart btn btn-default" onclick="location.href='/menu-detail/<%= item[0].menu_id %>';" />
								
								
								<!-- <a href="/menu-detail/<%= item[0].menu_id %>"> <button class="
                                <input type="submit" name="submit" value="submit" class="btn btn-primary btn-lg"style="margin-left: -100px;" onclick="location.href='/menu-detail/<%= item[0].menu_id %>';" />" type="button">Checkout</button> </a> -->
							</div>
						</form>
						<!-- <h4 class="price">REGULAR PIZZA: <span>Rs. <%= item[0].menu_price_regular %>/-</span></h4>
						<h4 class="price">LARGE PIZZA: <span>Rs. <%= item[0].menu_price_large %>/-</span></h4>
						<h4 class="price">EXTRA LARGE PIZZA: <span>Rs. <%= item[0].menu_price_xlarge %>/-</span></h4> -->
						<!-- <h5 class="sizes">sizes:
							<span class="size" data-toggle="tooltip" title="small">Regular</span>
							<span class="size" data-toggle="tooltip" title="large">Large</span>
							<span class="size" data-toggle="tooltip" title="xl">XL</span>
						</h5> -->
						<!-- <h5 class="colors">colors:
							<span class="color orange not-available" data-toggle="tooltip" title="Not In store"></span>
							<span class="color green"></span>
							<span class="color blue"></span>
						</h5> -->
					</div>
				</div>
			</div>
		</div>
	</div>
  </body>
</html>
