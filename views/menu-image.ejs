<!doctype html>
<html lang="en">
  <head>
  	<title>ADMIN PANEL</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
		
		<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom.css">
  <style> 
        body {
            width: 1000px;
            height: 1000px;
        }
        .my-custom {
            margin-left: 513.7px; 
            margin-right: -50%; 
            margin-top: 15px;
            width: 60%;
        }
        #my-custom {
            margin-left: -80%;
            margin-right: -30%; 
            margin-top: 10%;
        }
  </style>
    </head>
  <body style="background-color: #c5cae9;"> 
		<div class="wrapper d-flex align-items-stretch">
			<nav id="sidebar" class="active">
				<div class="custom-menu">
                    <button type="button" id="sidebarCollapse" class="btn btn-primary">
                        <i class="fa fa-bars"></i>
                        <span class="sr-only">Toggle Menu</span>
                    </button>
        </div>
				<div class="p-4">
		  		<h1><a href="index.html" class="logo">PANEL</a></h1>
	        <ul class="list-unstyled components mb-5">
	          <li class="active">
	            <a href="/admin/panel"><span class="fa fa-home mr-3"></span> Home</a>
	          </li>
	          <li>
	              <a href="#"><span class="fa fa-money mr-3"></span> Orders</a>
	          </li>
	          <li>
              <a href="#"><span class="fa fa-sticky-note mr-3"></span> Manage</a>
	          </li>
	          <li>
              <a href="#"><span class="fa fa-paper-plane mr-3"></span> Contact Dev</a>
	          </li>
	        </ul>

	        <div class="footer">
	        	<p hidden>Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0.
						  Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved | This template is made with <i class="icon-heart" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib.com</a>
						 Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. </p>
	        </div>

	      </div>
        </nav>

        <!-- Page Content  -->
        <div id="content">
            <div class="my-custom" class="col s12">
                <div class="navbar navbar-inverse navbar-static-top" >
                    <div class="container">
                        <a href="/admin/panel" class="navbar-brand">Admin Dashboard</a>
                        <a href="#">Logout</a>
                    </div>
                </div>
                
                <%= typeof msg != 'undefined' ? msg : '' %>
                <div class="row" style="margin-left: 30px;">
                    <form action="http://localhost:8000/admin/panel/menu/add-image" method="post" class="col s12" style="margin-top: 20px;" enctype="multipart/form-data">
           
                      
                      <div class="form-group row">
                        <label for="menu_name" class="col-2 col-form-label">Menu_Name</label>
                        <div class="col-10">
                          <h4> <%= detail.name %> </h4>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="menu_service_time" class="col-2 col-form-label">Service_Time</label>
                        <div class="col-10">
                          <h4> <%= detail.time %> </h4>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="menu_price_regular" class="col-2 col-form-label">Price_Regular</label>
                        <div class="col-10">
                          <h4> <%= detail.regular %> </h4>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="menu_price_large" class="col-2 col-form-label">Price_Large</label>
                        <div class="col-10">
                          <h4> <%= detail.large %> </h4>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="menu_price_xlarge" class="col-2 col-form-label">Price_Extra_Large</label>
                        <div class="col-10">
                          <h4 style="margin-left: 25px;" > <%= detail.xlarge %> </h4>
                        </div>
                    </div>


                        <div class="form-group row">
                            <label for="menu_service_time" class="col-2 col-form-label">Menu_Image</label>
                            <div class="col-10">
                                <input type="file" id="img" name="menu_image" accept="image/*">           
                            </div>
                        </div>
  
                        <div class="form-group row">
                            <label for="" class="col-2 col-form-label" style="color:#ffffff">Submit</label>
                            <div class="col-10">
                                <input type="submit" name="submit" value="Save event" class="btn btn-primary btn-lg"style="margin-left: -100px;">
                            </div>
                        </div>
                    </form>
                </div>
                
        </div>
        


    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>